---
import Base from "../layouts/Base.astro";

const cells = Array.from({ length: 12 * 8 }, (_, i) => i);
---

<Base title="Grid Test">
  <main class="page-shell">
    <div class="panel">
      <div class="grid-wrap" aria-label="Plus and dot grid">
        {cells.map((cell) => {
          const col = cell % 12;
          const row = Math.floor(cell / 12);
          const isDot = (col + row) % 4 === 0 || (col * row) % 5 === 0;

          return (
            <span
              class:list={["node", isDot && "dot"]}
              style={`--x:${col}; --y:${row};`}
              aria-hidden="true"
            />
          );
        })}
      </div>
    </div>
  </main>
</Base>

<style>
  .page-shell {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 40px 20px;
  }

  .panel {
    position: relative;
    width: min(92vw, 980px);
    height: min(72vh, 620px);
    border-radius: 28px;
    background:
      radial-gradient(circle at 50% 50%, rgba(255,255,255,0.06), transparent 48%),
      linear-gradient(135deg, #10141a 0%, #0d1116 30%, #121821 100%);
    border: 1px solid rgba(255,255,255,0.08);
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
  }

  .panel::before {
    content: "";
    position: absolute;
    inset: 24px;
    border-radius: 24px;
    border: 1px solid rgba(255,255,255,0.08);
    pointer-events: none;
  }

  .grid-wrap {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px);
    background-size: 40px 40px;
  }

  .node {
    position: absolute;
    left: calc(var(--x) * 40px + 44px);
    top: calc(var(--y) * 40px + 44px);
    width: 18px;
    height: 18px;
    display: block;
    opacity: 0.8;
  }

  .node::before,
  .node::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    background: rgba(160, 218, 255, 0.88);
  }

  .node::before {
    width: 2px;
    height: 18px;
    border-radius: 99px;
  }

  .node::after {
    width: 18px;
    height: 2px;
    border-radius: 99px;
  }

  .node.dot {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 0 12px rgba(255,255,255,0.7);
  }

  .node.dot::before,
  .node.dot::after {
    display: none;
  }
</style>
</Base>
