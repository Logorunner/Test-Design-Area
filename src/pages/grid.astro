---
import Base from "../layouts/Base.astro";

const projects = [
  {
    title: "WEB",
    tag: "01 / Web",
    description: "Digital experiences, interfaces, and the details that make them feel alive.",
  },
  {
    title: "PLAY",
    tag: "02 / Play",
    description: "Experiments with interaction, motion, and unexpected ways to explore.",
  },
];
---

<Base title="Web & Play">
  <main class="work-page">
    {projects.map((project, index) => (
      <section class:list={["work-section", index === 1 && "work-section--reverse"]}>
        <h1 class="work-title">{project.title}</h1>
        <article class="text-box">
          <span class="tag">{project.tag}</span>
          <p>{project.description}</p>
        </article>
      </section>
    ))}
  </main>
</Base>

<style>
  :global(body) {
    min-height: 100vh;
    padding: 0;
    overflow-x: hidden;
    background-color: #0b0c10;
    background-image: radial-gradient(circle, rgba(180, 205, 220, 0.58) 1.4px, transparent 1.7px);
    background-size: 34px 34px;
  }

  .work-page {
    position: relative;
    z-index: 1;
    width: min(1120px, 100%);
    margin: 0 auto;
    padding: 4rem clamp(24px, 8vw, 112px);
  }

  .work-section {
    position: relative;
    display: flex;
    min-height: 72vh;
    align-items: center;
    justify-content: space-between;
    gap: clamp(2rem, 8vw, 8rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .work-section--reverse {
    flex-direction: row-reverse;
  }

  .work-title {
    flex: 1;
    margin: 0;
    color: #f4f4f6;
    font-family: "Geologica", system-ui, sans-serif;
    font-size: clamp(5rem, 17vw, 13rem);
    font-weight: 900;
    letter-spacing: -0.075em;
    line-height: 0.82;
    text-shadow: none;
  }

  .text-box {
    flex: 0 1 340px;
    padding: 1.75rem;
    border: 1px solid rgba(155, 215, 255, 0.45);
    border-radius: 14px;
    background: rgba(15, 20, 27, 0.88);
    backdrop-filter: blur(8px);
  }

  .tag {
    display: block;
    margin-bottom: 0.75rem;
    color: #66fcf1;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .text-box p {
    margin: 0;
    color: #dbe9f4;
    line-height: 1.6;
  }

  @media (max-width: 700px) {
    .work-page {
      padding-top: 1rem;
    }

    .work-section,
    .work-section--reverse {
      min-height: 78vh;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 2rem;
    }

    .work-title {
      font-size: clamp(5rem, 23vw, 9rem);
    }

    .text-box {
      flex-basis: auto;
      width: min(100%, 380px);
      align-self: flex-end;
    }
  }
</style>
