---
const { title = "Test Design Area" } = Astro.props;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <style is:global>
      :root { color-scheme: dark; }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        padding: 48px clamp(20px, 5vw, 64px);
        background: #0b0c10;
        color: #f2f4f6;
        font: 300 17px/1.7 "Archivo", system-ui, -apple-system, sans-serif;
        letter-spacing: 0.01em;
      }
      a { color: #00b4ff; }
      h1 { font-size: clamp(30px, 5vw, 54px); font-weight: 800; letter-spacing: -0.035em; margin: 0 0 10px; }
      .lede { color: rgba(255,255,255,0.7); max-width: 56ch; margin: 0 0 40px; }
      ul.tests { list-style: none; padding: 0; margin: 0; max-width: 56ch; }
      ul.tests li { border-top: 1px solid rgba(255,255,255,0.14); padding: 18px 0; }
      ul.tests a { font-size: 21px; font-weight: 600; letter-spacing: -0.02em; text-decoration: none; }
      ul.tests a:hover { text-decoration: underline; }
      ul.tests p { margin: 4px 0 0; font-size: 15px; color: rgba(255,255,255,0.55); }
    </style>
  </head>
  <body><slot /></body>
</html>
