---
import Base from "../layouts/Base.astro";

const projects = [
  {
    title: "WEB",
    tag: "01 / Web",
    description: "Digital experiences, interfaces, and the details that make them feel alive.",
  },
  {
    title: "PLAY",
    tag: "02 / Play",
    description: "Experiments with interaction, motion, and unexpected ways to explore.",
  },
  {
    title: "DESIGN",
    tag: "03 / Design",
    description: "A visual language built from structure, tone, rhythm, and atmosphere.",
  },
];
---

<Base title="Web & Play">
  <main class="work-page">
    {projects.map((project) => (
      <section class="work-section">
        <h1 class="work-title">{project.title}</h1>
        <article class="text-box">
          <span class="tag">{project.tag}</span>
          <p>{project.description}</p>
        </article>
      </section>
    ))}
  </main>
</Base>

<style>
  :global(body) {
    min-height: 100vh;
    padding: 0;
    overflow-x: hidden;
    background-color: #0b0c10;
    background-image: radial-gradient(circle, rgba(180, 205, 220, 0.58) 1.4px, transparent 1.7px);
    background-size: 34px 34px;
  }

  .work-page {
    width: min(1100px, calc(100% - 44px));
    margin: 0 auto;
    padding: 2rem 0 5rem;
  }

  .work-section {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    min-height: 32vh;
    padding: 1.2rem 0 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .work-title {
    margin: 0;
    color: #f4f4f6;
    font-family: "Geologica", system-ui, sans-serif;
    font-size: clamp(4.2rem, 12vw, 12rem);
    font-weight: 900;
    line-height: 0.8;
    letter-spacing: -0.075em;
    text-transform: uppercase;
    text-shadow: none;
  }

  .text-box {
    align-self: flex-end;
    width: min(100%, 320px);
    padding: 1.2rem 1.1rem;
    border: 1px solid rgba(155, 215, 255, 0.45);
    border-radius: 14px;
    background: rgba(15, 20, 27, 0.9);
  }

  .tag {
    display: block;
    margin-bottom: 0.75rem;
    color: #66fcf1;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .text-box p {
    margin: 0;
    color: #dbe9f4;
    line-height: 1.6;
  }

  @media (max-width: 700px) {
    .work-page {
      width: min(100% - 28px, 100%);
      padding-top: 1rem;
    }

    .text-box {
      width: 100%;
      align-self: stretch;
    }
  }
</style>
