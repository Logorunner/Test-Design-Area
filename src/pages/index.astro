---
import Base from "../layouts/Base.astro";

// Add a line here when you add a test. Pages in src/pages are Astro;
// anything self-contained can live in public/ and be linked straight.
// Links have to carry the base path, or they break on GitHub Pages where
// the site lives at /Test-Design-Area rather than at the root.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const tests = [
  {
    href: `${base}/dots.html`,
    title: "Dots",
    note: "Pointer-reactive dot field, click to collapse. Plain HTML in public/, untouched by the build.",
  },
];
---
<Base title="Test Design Area">
  <h1>Test Design Area</h1>
  <p class="lede">A place to play. Astro, static, nothing on the server.</p>
  <ul class="tests">
    {tests.map((t) => (
      <li>
        <a href={t.href}>{t.title}</a>
        <p>{t.note}</p>
      </li>
    ))}
  </ul>
</Base>
